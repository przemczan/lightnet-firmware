#pragma once

// Panel debug output goes out DebugSerial's bit-banged PD7 TX (see
// lib/Lightnet/Panel/DebugSerial.hpp) -- both of the panel's real USART pins are owned by the
// relay trunk, so this is the only debug channel available. 9600 baud, 8N1, idle high.
#define DEBUG 0

// ── Debug sub-switches ────────────────────────────────────────────────────────
// All sub-switches default to 1 when DEBUG=1 (see lib/Lightnet/Utils/Debug.hpp). Set DEBUG=1 and
// uncomment a line below to disable a specific area:
// #define DEBUG 1
// #define DEBUG_INIT      0   // startup/boot logs
// #define DEBUG_DISCOVERY 0   // relay discovery protocol logs
// #define DEBUG_RGB_CTRL  0   // LED output logs

// ── Relay trunk ───────────────────────────────────────────────────────────────
// UART baud of the panel's edge links. Must match the controller's LIGHTNET_TRUNK_BAUD and the
// relay bootloader (burned separately -- re-burn it after changing this). Use exact 16MHz UBRR
// divisors (2000000, 1000000, 500000, 250000, ...) so the AVR's baud error is 0%.
#define LIGHTNET_TRUNK_BAUD 500000UL
